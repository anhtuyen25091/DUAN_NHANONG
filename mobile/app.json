{
  "expo": {
    "name": "Nhà Nông",
    "slug": "nha-nong",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.nhanong.app",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Nhà Nông kết nối WiFi của thiết bị cảm biến ở ruộng để lấy số đo khi không có mạng."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "vn.nhanong.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Nhà Nông dùng vị trí để tìm đại lý và điểm thu mua gần bạn."
        }
      ],
      "expo-sharing",
      "expo-status-bar"
    ],
    "scheme": "nhanong",
    "experiments": {
      "typedRoutes": true
    }
  }
}

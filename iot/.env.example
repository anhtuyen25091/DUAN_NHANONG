APP_NAME="Nhà Nông IoT"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001
APP_TIMEZONE=Asia/Ho_Chi_Minh

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nhanong_iot
DB_USERNAME=nhanong
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Tách khỏi backend/ (dùng chung Redis trong docker-compose)
REDIS_DB=2
REDIS_CACHE_DB=3

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Webhook LoRaWAN (ChirpStack / The Things Stack) gửi kèm header X-Webhook-Secret
IOT_LORAWAN_SECRET=
# Gửi lệnh bật / tắt xuống relay LoRaWAN qua ChirpStack v4 (chirpstack-rest-api, VD http://chirpstack:8090). The Things Stack không cần.
CHIRPSTACK_API_URL=
CHIRPSTACK_API_TOKEN=
IOT_LORAWAN_DOWNLINK_FPORT=2
# Cổng SMS gửi kèm header X-Webhook-Secret
IOT_SMS_SECRET=
# MQTT (Mosquitto trong docker-compose)
IOT_MQTT_HOST=127.0.0.1
IOT_MQTT_PORT=1883
IOT_MQTT_USERNAME=
IOT_MQTT_PASSWORD=
# Mã client cố định (phiên bền: broker giữ bản tin khi iot:mqtt-listen khởi động lại). Chỉ chạy 1 tiến trình.
IOT_MQTT_CLIENT_ID=nhanong-iot-listener
# Không bắt buộc: chỉ cần khi bật "Enhanced push security" trên Expo
EXPO_ACCESS_TOKEN=

# Backend Nhà Nông (dùng chung gói trả phí với tài khoản đã nối)
NHANONG_API_URL=http://127.0.0.1:8000
